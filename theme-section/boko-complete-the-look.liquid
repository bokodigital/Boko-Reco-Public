  "name": "Complete the Look",
  "target": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Complete the Look" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow (defaults to product type/collection)" },
    { "type": "range", "id": "limit", "label": "Number of recommendations", "min": 2, "max": 6, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "use_theme_fonts", "label": "Use theme fonts", "default": true }
  ],
  "presets": [{ "name": "Complete the Look" }]
}
