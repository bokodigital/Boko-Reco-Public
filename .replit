run = "cd web && npm install && npm start"
entrypoint = "web/server.js"
modules = ["nodejs-20", "web", "python-3.12"]

[nix]
channel = "stable-25_05"

[env]
SCOPES = "read_products,read_orders"
LLM_MODEL = "gpt-4o-mini"

[[ports]]
localPort = 3000
externalPort = 80

[[ports]]
localPort = 3999
externalPort = 3000

[agent]
expertMode = true

[deployment]
deploymentTarget = "autoscale"
build = ["sh", "-c", "cd web && npm install"]
run = ["sh", "-c", "cd web && node server.js"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd web && npm install && npm start"
waitForPort = 3000

[workflows.workflow.metadata]
outputType = "console"
