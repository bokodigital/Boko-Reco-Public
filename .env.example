# Copy to web/.env (local) or set in your host's env. Never commit the real values.

# --- Shopify app (Partner dashboard > App setup) ---
SHOPIFY_API_KEY=your_client_id
SHOPIFY_API_SECRET=your_client_secret
SCOPES=read_products,read_orders
HOST=https://your-app-host.example.com
PORT=3000
SESSION_DB_PATH=/var/data/database.sqlite

# --- AI suggestions (optional; leave blank to use heuristics only) ---
# Pick ONE provider.
#
# OpenAI / GPT (or any OpenAI-compatible endpoint: Groq, OpenRouter, Azure):
#   LLM_PROVIDER=openai
#   LLM_API_URL=https://api.openai.com/v1/chat/completions
#   LLM_MODEL=gpt-4o-mini
#
# Anthropic / Claude:
#   LLM_PROVIDER=anthropic
#   LLM_API_URL=https://api.anthropic.com/v1/messages
#   LLM_MODEL=claude-3-5-haiku-latest
#
LLM_PROVIDER=
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=
